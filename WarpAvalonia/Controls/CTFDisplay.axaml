<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WarpAvalonia.Controls.CTFDisplay">
    <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
        <!-- Top-left: Simulated 2D CTF -->
        <Image Grid.Row="0" Grid.Column="0" Name="ImageSimulated2D" Stretch="Fill" />

        <!-- Top-right: 1D CTF plot (custom, replaces LiveCharts) -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Canvas Name="CanvasPlot1D" Background="Transparent" />
            <!-- CTF parameters overlay -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
                <StackPanel Orientation="Horizontal" Height="16">
                    <TextBlock Text="Defocus: " Width="80" FontSize="11" />
                    <TextBlock Name="TextDefocus" Text="-- um" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="16">
                    <TextBlock Text="Astigmatism: " Width="80" FontSize="11" />
                    <TextBlock Name="TextAstigmatism" Text="-- um" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="16">
                    <TextBlock Text="Phase shift: " Width="80" FontSize="11" />
                    <TextBlock Name="TextPhase" Text="-- pi" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Height="16">
                    <TextBlock Text="Resolution: " Width="80" FontSize="11" />
                    <TextBlock Name="TextResolution" Text="-- A" FontSize="11" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Bottom: 2D Power Spectrum -->
        <Image Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="ImagePS2D" Stretch="Fill" />

        <!-- Placeholder messages -->
        <TextBlock Grid.RowSpan="2" Grid.ColumnSpan="2" Name="TextNoData"
                   Text="Please select a movie or tilt series."
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="16" Foreground="Gray" IsVisible="False" />
    </Grid>
</UserControl>
