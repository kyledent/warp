<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:WarpAvalonia.Controls"
             x:Class="WarpAvalonia.Controls.ValueSlider"
             x:DataType="c:ValueSlider">
    <StackPanel Orientation="Horizontal" Spacing="2">
        <TextBox Name="TextValue"
                 MinWidth="36"
                 Padding="3,1"
                 FontSize="12"
                 VerticalAlignment="Center"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Right"
                 BorderThickness="0,0,0,1"
                 BorderBrush="#40808080"
                 Background="Transparent"
                 Text="{Binding ValueText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
        <TextBlock Name="TextSuffix"
                   Text="{Binding Suffix, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="11"
                   Foreground="Gray"
                   VerticalAlignment="Center"
                   IsVisible="{Binding HasSuffix, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </StackPanel>
</UserControl>
