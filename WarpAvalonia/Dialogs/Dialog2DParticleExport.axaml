<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WarpAvalonia.Controls"
        x:Class="WarpAvalonia.Dialogs.Dialog2DParticleExport"
        Title="Export Particles (2D)"
        Width="700" Height="550"
        WindowStartupLocation="CenterOwner" CanResize="False" FontSize="12">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="20">
        <TextBlock Text="Export particles" FontSize="24" Margin="0,10,0,20" />
        <StackPanel Name="PanelConfiguration" Spacing="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Coordinate pixel size: " VerticalAlignment="Center" />
                <c:ValueSlider Value="{Binding Tasks.InputPixelSize, Converter={x:Static c:DecimalDoubleConverter.Instance}}"
                               MinValue="0.01" MaxValue="1000" StepSize="0.0001" DecimalPlaces="4" Suffix="Å/px" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Export pixel size: " VerticalAlignment="Center" />
                <c:ValueSlider Value="{Binding Tasks.Export2DPixel, Converter={x:Static c:DecimalDoubleConverter.Instance}}"
                               MinValue="0.01" MaxValue="1000" StepSize="0.01" DecimalPlaces="2" Suffix="Å/px" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Box size: " VerticalAlignment="Center" />
                <c:ValueSlider Value="{Binding Tasks.Export2DBoxSize}" MinValue="2" MaxValue="1024" StepSize="2" DecimalPlaces="0" Suffix="px" />
                <TextBlock Text="  Diameter: " VerticalAlignment="Center" />
                <c:ValueSlider Value="{Binding Tasks.Export2DParticleDiameter}" MinValue="2" MaxValue="1024" StepSize="2" DecimalPlaces="0" Suffix="px" />
            </StackPanel>

            <Separator Margin="0,4" />

            <StackPanel Orientation="Horizontal" Spacing="16">
                <RadioButton Name="RadioAverage" GroupName="ExportMode" Content="Averages" IsChecked="{Binding Tasks.Export2DDoAverages}" />
                <RadioButton Name="RadioStack" GroupName="ExportMode" Content="Stacks" IsChecked="{Binding Tasks.Export2DDoMovies}" />
                <RadioButton Name="RadioDenoising" GroupName="ExportMode" Content="Denoising pairs" IsChecked="{Binding Tasks.Export2DDoDenoisingPairs}" />
                <RadioButton Name="RadioStar" GroupName="ExportMode" Content="Only STAR" />
            </StackPanel>

            <CheckBox Name="CheckInvert" IsChecked="{Binding Tasks.InputInvert}" Content="Invert contrast" />
            <CheckBox Name="CheckNormalize" IsChecked="{Binding Tasks.InputNormalize}" Content="Normalize" />
            <CheckBox Name="CheckPreflip" IsChecked="{Binding Tasks.Export2DPreflip}" Content="Pre-flip phases" />
            <CheckBox Name="CheckOneInputPerItem" Content="Use per-item input" />
            <CheckBox Name="CheckRelative" IsChecked="{Binding Tasks.UseRelativePaths}" Content="Relative paths" />
            <CheckBox Name="CheckFilter" IsChecked="{Binding Tasks.IncludeFilteredOut}" Content="Include filtered out" />
            <CheckBox Name="CheckManual" IsChecked="{Binding Tasks.IncludeUnselected}" Content="Include deselected" />

            <StackPanel Height="50" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
                <Button Content="EXPORT" FontSize="18" FontWeight="Medium" Foreground="CornflowerBlue"
                        Background="Transparent" BorderThickness="0" Click="ButtonExport_OnClick" />
                <Button Content="CANCEL" FontSize="18" FontWeight="Medium" Foreground="CornflowerBlue"
                        Background="Transparent" BorderThickness="0" Margin="24,0,0,0" Click="ButtonCancel_OnClick" />
            </StackPanel>
        </StackPanel>
        <StackPanel Name="PanelProgress" IsVisible="False" Spacing="10" Margin="0,10">
            <ProgressBar Name="ProgressWrite" Minimum="0" Maximum="100" />
            <StackPanel Name="PanelRemaining" Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Name="TextRemaining" FontSize="14" />
            </StackPanel>
            <Button Name="ButtonAbort" Content="CANCEL" FontSize="18" FontWeight="Medium"
                    Foreground="Red" Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Center" Click="ButtonAbort_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
