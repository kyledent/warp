<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WarpAvalonia.Dialogs.BoxNetSelect"
        Title="Select BoxNet Model"
        Width="450" Height="350"
        WindowStartupLocation="CenterOwner" FontSize="12">
    <StackPanel Margin="20" Spacing="8">
        <TextBlock Text="Select BoxNet model" FontSize="24" Margin="0,10,0,10" />
        <ListBox Name="ListModels" Height="180" />
        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="BROWSE" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" Click="ButtonBrowse_OnClick" />
            <Button Content="USE" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" Click="ButtonUse_OnClick" />
            <Button Content="CANCEL" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" Click="ButtonCancel_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
