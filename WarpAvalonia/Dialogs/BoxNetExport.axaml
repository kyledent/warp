<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WarpAvalonia.Controls"
        x:Class="WarpAvalonia.Dialogs.BoxNetExport"
        Title="Export BoxNet Training Examples"
        Width="550" Height="350"
        WindowStartupLocation="CenterOwner" FontSize="12">
    <StackPanel Margin="20" Spacing="8">
        <TextBlock Text="Export BoxNet training examples" FontSize="24" Margin="0,10,0,10" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Particle diameter: " VerticalAlignment="Center" />
            <c:ValueSlider Value="{Binding Picking.Diameter}" MinValue="10" MaxValue="700" StepSize="10" DecimalPlaces="0" Suffix="A" />
        </StackPanel>
        <CheckBox Content="Negative stain" IsChecked="{Binding Picking.DataStyle}" />
        <ProgressBar Name="ProgressExport" IsVisible="False" Minimum="0" Maximum="100" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16" Margin="0,10,0,0">
            <Button Content="EXPORT" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" Click="ButtonExport_OnClick" />
            <Button Content="CANCEL" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" Click="ButtonCancel_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
