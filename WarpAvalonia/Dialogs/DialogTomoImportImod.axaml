<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WarpAvalonia.Dialogs.DialogTomoImportImod"
        Title="Import Tilt Series from IMOD"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner" FontSize="12">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Import tilt series from IMOD" FontSize="24" Margin="0,10,0,20" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="MDOC folder:" VerticalAlignment="Center" Width="100" />
                    <Button Name="ButtonMdocFolder" Content="Select folder..."
                            Background="Transparent" BorderThickness="0" Foreground="CornflowerBlue"
                            Click="ButtonMdocFolder_OnClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="IMOD folder:" VerticalAlignment="Center" Width="100" />
                    <Button Name="ButtonImodFolder" Content="Select folder..."
                            Background="Transparent" BorderThickness="0" Foreground="CornflowerBlue"
                            Click="ButtonImodFolder_OnClick" />
                </StackPanel>
                <TextBlock Name="TextStatus" Text="Select MDOC and IMOD folders to begin." Foreground="Gray" Margin="0,8" />
                <ProgressBar Name="ProgressImport" IsVisible="False" Minimum="0" Maximum="100" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="IMPORT" FontSize="18" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" Click="ButtonImport_OnClick" />
            <Button Content="CANCEL" FontSize="18" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" Margin="24,0,0,0" Click="ButtonCancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
