<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WarpAvalonia.Controls"
        x:Class="WarpAvalonia.Dialogs.Dialog2DParticleImport"
        Title="Import Particle Coordinates"
        Width="550" Height="320"
        WindowStartupLocation="CenterOwner" CanResize="False" FontSize="12">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="20">
        <TextBlock Text="Import particle coordinates" FontSize="24" Margin="0,10,0,20" />
        <Grid RowDefinitions="30,30,30,10,30,36,50">
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="Coordinates use " FontSize="16" VerticalAlignment="Center" />
                <c:ValueSlider Value="{Binding Tasks.InputPixelSize, Converter={x:Static c:DecimalDoubleConverter.Instance}}"
                               MinValue="0.01" MaxValue="1000" StepSize="0.0001" DecimalPlaces="4" Suffix="A/px" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal">
                <TextBlock Text="Shifts use " FontSize="16" VerticalAlignment="Center" />
                <c:ValueSlider Value="{Binding Tasks.InputShiftPixelSize, Converter={x:Static c:DecimalDoubleConverter.Instance}}"
                               MinValue="0.01" MaxValue="1000" StepSize="0.0001" DecimalPlaces="4" Suffix="A/px" />
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
                <CheckBox IsChecked="{Binding Tasks.InputFlipX}" Content="Flip X" FontSize="16" />
                <CheckBox IsChecked="{Binding Tasks.InputFlipY}" Content="Flip Y" FontSize="16" />
            </StackPanel>
            <TextBlock Grid.Row="4" Text="Suffix for imported files:" FontSize="16" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Name="TextSuffix" FontSize="16" />
            <ProgressBar Grid.Row="6" Name="ProgressWrite" IsVisible="False" Minimum="0" Maximum="100" />
            <StackPanel Grid.Row="6" Name="PanelButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="IMPORT" FontSize="18" FontWeight="Medium" Foreground="CornflowerBlue"
                        Background="Transparent" BorderThickness="0" Click="ButtonWrite_OnClick" />
                <Button Content="CANCEL" FontSize="18" FontWeight="Medium" Foreground="CornflowerBlue"
                        Background="Transparent" BorderThickness="0" Margin="24,0,0,0" Click="ButtonCancel_OnClick" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
