<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:CubeAvalonia.Controls"
        x:Class="CubeAvalonia.CoordsImportWindow"
        Title="Import Coordinates"
        Width="400" Height="280"
        WindowStartupLocation="CenterOwner" CanResize="False" FontSize="12">
    <StackPanel Margin="20" Spacing="8">
        <TextBlock Text="Import Coordinates" FontSize="20" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Volume width:" Width="100" VerticalAlignment="Center" />
            <c:ValueSlider Name="SliderWidth" MinValue="1" MaxValue="10000" StepSize="1" DecimalPlaces="0" Value="512" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Volume height:" Width="100" VerticalAlignment="Center" />
            <c:ValueSlider Name="SliderHeight" MinValue="1" MaxValue="10000" StepSize="1" DecimalPlaces="0" Value="512" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Volume depth:" Width="100" VerticalAlignment="Center" />
            <c:ValueSlider Name="SliderDepth" MinValue="1" MaxValue="10000" StepSize="1" DecimalPlaces="0" Value="512" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
            <CheckBox Name="CheckInvertX" Content="Invert X" />
            <CheckBox Name="CheckInvertY" Content="Invert Y" />
            <CheckBox Name="CheckInvertZ" Content="Invert Z" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16" Margin="0,16,0,0">
            <Button Content="IMPORT" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" Click="ButtonImport_OnClick" />
            <Button Content="CANCEL" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" Click="ButtonCancel_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
