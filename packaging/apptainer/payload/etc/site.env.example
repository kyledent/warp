# Site defaults for warp-slurm, installed as /opt/warp/etc/site.env by build_sif.sh --site <dir>.
# An environment variable of the same name wins at run time.
WARP_SLURM_URL=https://slurmrestd.example.org:6820
WARP_SLURM_API=v0.0.42
# A bare JWT, or a JSON cache with a SLURM_JWT field.
WARP_SLURM_TOKEN_FILE=~/.slurm/jwt
WARP_SLURM_TOKEN_HELP=Create one with: scontrol token lifespan=86400 | sed -n 's/^SLURM_JWT=//p' > ~/.slurm/jwt; chmod 600 ~/.slurm/jwt
