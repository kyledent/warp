<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MAvalonia.MainWindow"
        Title="M — Multi-Particle Refinement"
        Width="1200" Height="800" FontSize="12">
    <Grid RowDefinitions="Auto,*">
        <!-- GPU list with free memory; unticked GPUs are not used (WPF M: title bar) -->
        <StackPanel Grid.Row="0" Name="PanelGPUStats" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4,4,4,0" />

        <!-- Landing panel (no population loaded) -->
        <StackPanel Grid.Row="1" Name="PanelLanding" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="CREATE NEW POPULATION" FontSize="36" HorizontalAlignment="Center"
                    Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0"
                    Click="ButtonPopulationCreateNew_OnClick" />
            <Button Content="LOAD EXISTING FROM FILE" FontSize="36" Margin="0,30,0,0" HorizontalAlignment="Center"
                    Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0"
                    Click="ButtonPopulationLoad_OnClick" />
        </StackPanel>

        <!-- Main panel (population loaded) -->
        <Grid Grid.Row="1" Name="PanelMain" IsVisible="False" RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,8" Spacing="16">
                <TextBlock Name="TextPopulationName" Text="" FontSize="24" FontWeight="Light" VerticalAlignment="Center" />
                <Button Content="MANAGE DATA SOURCES" FontWeight="Medium" Foreground="CornflowerBlue"
                        Background="Transparent" BorderThickness="0"
                        Click="ButtonPopulationEditSources_OnClick" />
                <TextBlock Name="TextSourceStats" Text="" Foreground="Gray" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Species grid -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <WrapPanel Name="PanelSpecies" Orientation="Horizontal" Margin="16" />
            </ScrollViewer>

            <!-- Bottom bar: Add Species + Refine -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="16,8">
                <Button Grid.Column="0" Content="+ ADD SPECIES" FontSize="14" FontWeight="Medium"
                        Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0"
                        Click="ButtonPopulationAddSpecies_OnClick" />
                <Button Grid.Column="1" Name="ButtonRefine" Content="REFINE" FontSize="36"
                        FontWeight="Medium" Background="Transparent" BorderThickness="0"
                        Click="ButtonRefine_OnClick">
                    <Button.Foreground>
                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="DeepSkyBlue" Offset="0" />
                            <GradientStop Color="DeepPink" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Foreground>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
