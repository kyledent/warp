<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MAvalonia.Dialogs.DialogDataSources" Title="Manage Data Sources"
        MinWidth="560" SizeToContent="WidthAndHeight" MaxHeight="900" WindowStartupLocation="CenterOwner" FontSize="14">
    <!-- As WPF M's M/Controls/Sociology/Dialogs/DialogDataSources.xaml: a table of sources built in code. -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <TextBlock Grid.Row="0" Text="Manage data sources" FontSize="24" Margin="0,0,0,16" />
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Name="GridSources" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" />
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <Button Grid.Column="0" Content="ADD LOCAL" FontSize="18" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Click="ButtonAddLocal_OnClick" />
            <Button Grid.Column="1" Content="CLOSE" FontSize="20" FontWeight="Medium" Foreground="CornflowerBlue"
                    Background="Transparent" BorderThickness="0" Click="ButtonClose_OnClick" />
        </Grid>
    </Grid>
</Window>
