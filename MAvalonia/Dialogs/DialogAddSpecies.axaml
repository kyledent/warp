<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MAvalonia.Dialogs.DialogAddSpecies" Title="Add Species"
        Width="400" Height="200" WindowStartupLocation="CenterOwner" CanResize="False" FontSize="12">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Add species" FontSize="24" />
        <RadioButton Name="RadioFromScratch" Content="Create from scratch (half-maps + particles)" IsChecked="True" GroupName="Source" />
        <RadioButton Name="RadioFromLocal" Content="Import from local species folder" GroupName="Source" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16" Margin="0,10,0,0">
            <Button Content="NEXT" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0" Click="ButtonNext_OnClick" />
            <Button Content="CANCEL" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0" Click="ButtonCancel_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
