<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MAvalonia.Dialogs.DialogSpeciesRotate" Title="Rotate Species"
        Width="400" Height="220" WindowStartupLocation="CenterOwner" CanResize="False" FontSize="12">
    <StackPanel Margin="20" Spacing="8">
        <TextBlock Text="Rotate species" FontSize="24" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Rot:" VerticalAlignment="Center" /><TextBox Name="TextRot" Width="60" Text="0" />
            <TextBlock Text="Tilt:" VerticalAlignment="Center" /><TextBox Name="TextTilt" Width="60" Text="0" />
            <TextBlock Text="Psi:" VerticalAlignment="Center" /><TextBox Name="TextPsi" Width="60" Text="0" />
            <TextBlock Text="deg" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16" Margin="0,10,0,0">
            <Button Content="APPLY" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0" Click="ButtonApply_OnClick" />
            <Button Content="CANCEL" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0" Click="ButtonCancel_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
