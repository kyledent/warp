<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MAvalonia.Dialogs.DialogSpeciesSymExpand" Title="Symmetry Expansion"
        Width="450" Height="250" WindowStartupLocation="CenterOwner" CanResize="False" FontSize="12">
    <StackPanel Margin="20" Spacing="8">
        <TextBlock Text="Symmetry expansion" FontSize="24" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Current symmetry:" VerticalAlignment="Center" />
            <TextBox Name="TextCurrentSym" Width="80" IsReadOnly="True" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Expand to:" VerticalAlignment="Center" />
            <TextBox Name="TextNewSym" Width="80" Text="C1" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
            <RadioButton Content="Keep original symmetry" IsChecked="True" GroupName="Remaining" />
            <RadioButton Content="Remove symmetry" GroupName="Remaining" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16" Margin="0,10,0,0">
            <Button Content="EXPAND" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0" Click="ButtonApply_OnClick" />
            <Button Content="CANCEL" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0" Click="ButtonCancel_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
