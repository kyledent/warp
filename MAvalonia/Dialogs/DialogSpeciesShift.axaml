<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MAvalonia.Dialogs.DialogSpeciesShift" Title="Shift Species"
        Width="400" Height="200" WindowStartupLocation="CenterOwner" CanResize="False" FontSize="12">
    <StackPanel Margin="20" Spacing="8">
        <TextBlock Text="Shift species" FontSize="24" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="X:" VerticalAlignment="Center" /><TextBox Name="TextX" Width="60" Text="0" />
            <TextBlock Text="Y:" VerticalAlignment="Center" /><TextBox Name="TextY" Width="60" Text="0" />
            <TextBlock Text="Z:" VerticalAlignment="Center" /><TextBox Name="TextZ" Width="60" Text="0" />
            <TextBlock Text="A" VerticalAlignment="Center" Foreground="Gray" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16" Margin="0,10,0,0">
            <Button Content="APPLY" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0" Click="ButtonApply_OnClick" />
            <Button Content="CANCEL" FontSize="16" FontWeight="Medium" Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0" Click="ButtonCancel_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
