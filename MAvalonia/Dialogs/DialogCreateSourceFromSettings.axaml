<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MAvalonia.Dialogs.DialogCreateSourceFromSettings" Title="Create Data Source"
        Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" FontSize="14">
    <!-- As WPF M's M/Controls/Sociology/Dialogs/DialogCreateSourceFromSettings.xaml; the pie chart
         of item status is shown as counts. -->
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Name="TextTitle" Text="Create data source from previous.settings" FontSize="24" TextWrapping="Wrap" />

        <StackPanel Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="14" Height="14" Background="#5A008000" VerticalAlignment="Center" />
                <TextBlock Name="TextProcessed" Text="0 processed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="14" Height="14" Background="#5A00BFFF" VerticalAlignment="Center" />
                <TextBlock Name="TextFilteredOut" Text="0 filtered out" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="14" Height="14" Background="#5AA9A9A9" VerticalAlignment="Center" />
                <TextBlock Name="TextDeselected" Text="0 deselected" />
            </StackPanel>
        </StackPanel>

        <TextBlock FontStyle="Italic" TextWrapping="Wrap"
                   Text="Adjust the settings in Warp before converting them to a source." />

        <TextBox Name="TextSourceName" Text="New Source Name" FontSize="16" />
        <CheckBox Name="CheckFilter" Content="Include items outside of filter ranges" />
        <CheckBox Name="CheckManual" Content="Include manually excluded items" />
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Use only first" VerticalAlignment="Center" />
            <NumericUpDown Name="NumericFrames" Minimum="1" Maximum="99999" Increment="1" FormatString="0" Value="1" MinWidth="120" />
            <TextBlock Text="frames/tilts" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="24" Margin="0,10,0,0">
            <Button Content="CREATE" FontSize="18" FontWeight="Medium" Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0" Click="ButtonCreate_OnClick" />
            <Button Content="CANCEL" FontSize="18" FontWeight="Medium" Foreground="CornflowerBlue" Background="Transparent" BorderThickness="0" Click="ButtonCancel_OnClick" />
        </StackPanel>
    </StackPanel>
</Window>
