  <PropertyGroup Label="WarpDeps">
    <!-- Prefix holding libtiff (include\tiffio.h, lib\tiff.lib), e.g. a conda env's Library folder.
         Order: /p:WarpDepsPrefix=..., then the WARP_DEPS_PREFIX environment variable, then an active
         conda env. The build stops with an error if none of these has tiffio.h. -->
    <WarpDepsPrefix Condition="'$(WarpDepsPrefix)'=='' and '$(WARP_DEPS_PREFIX)'!=''">$(WARP_DEPS_PREFIX)</WarpDepsPrefix>
    <WarpDepsPrefix Condition="'$(WarpDepsPrefix)'=='' and '$(CONDA_PREFIX)'!='' and Exists('$(CONDA_PREFIX)\Library\include\tiffio.h')">$(CONDA_PREFIX)\Library</WarpDepsPrefix>
    <!-- The post-build step copies libtiff/fftw runtime DLLs from CONDA_BIN. Default: the same deps env. -->
    <CONDA_BIN Condition="'$(CONDA_BIN)'==''">$(WarpDepsPrefix)\bin</CONDA_BIN>
    <!-- Building this project on its own (not via Warp.sln) still puts its output next to the apps. -->
    <SolutionDir Condition="'$(SolutionDir)'==''">$(MSBuildThisFileDirectory)..\</SolutionDir>
    <!-- Host CPU instruction set for the C++ sources. AVX2 by default, matching CMake (-mavx2 -mf16c); the
         AVX2 code paths are guarded by __AVX2__. Pre-Haswell CPUs: /p:WarpEnhancedInstructionSet=AdvancedVectorExtensions. -->
    <WarpEnhancedInstructionSet Condition="'$(WarpEnhancedInstructionSet)'==''">AdvancedVectorExtensions2</WarpEnhancedInstructionSet>
  </PropertyGroup>
  <PropertyGroup Label="CudaBuildCustomization">
    <!-- Find the CUDA 12.8 MSBuild customization without pinning to one VS install. Works with
         VS 2022 (v170) and VS 2026 / 18 (v180). CUDA 12.x is required, because CUDA 13 cannot
         target sm_52 (Maxwell).
         Order: 1) the host VS's BuildCustomizations (CUDA installer integrated with this VS);
                2) the CUDA 12.8 toolkit's own copy (no copying into VS needed, e.g. for VS 2026,
                   which the 12.8 installer does not integrate with);
                3) legacy: redirect to a VS 2022 Community install that has it (previous behaviour).
         Override with /p:WarpCudaCustomizationDir=<dir containing "CUDA 12.8.props">. -->
    <WarpCudaCustomizationDir Condition="'$(WarpCudaCustomizationDir)'=='' and Exists('$(VCTargetsPath)BuildCustomizations\CUDA 12.8.props')">$(VCTargetsPath)BuildCustomizations\</WarpCudaCustomizationDir>
    <WarpCudaCustomizationDir Condition="'$(WarpCudaCustomizationDir)'=='' and '$(CUDA_PATH_V12_8)'!='' and Exists('$(CUDA_PATH_V12_8)\extras\visual_studio_integration\MSBuildExtensions\CUDA 12.8.props')">$(CUDA_PATH_V12_8)\extras\visual_studio_integration\MSBuildExtensions\</WarpCudaCustomizationDir>
    <WarpLegacyVS2022VCTargets>C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VC\v170\</WarpLegacyVS2022VCTargets>
    <VCTargetsPath Condition="'$(WarpCudaCustomizationDir)'=='' and Exists('$(WarpLegacyVS2022VCTargets)BuildCustomizations\CUDA 12.8.props')">$(WarpLegacyVS2022VCTargets)</VCTargetsPath>
    <WarpCudaCustomizationDir Condition="'$(WarpCudaCustomizationDir)'=='' and Exists('$(VCTargetsPath)BuildCustomizations\CUDA 12.8.props')">$(VCTargetsPath)BuildCustomizations\</WarpCudaCustomizationDir>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="WarpToolset">
    <!-- v143 (MSVC 14.4x) is NVIDIA's supported host compiler for CUDA 12.x. VS 2026 can install it as
         the "MSVC v143 - VS 2022 C++ x64/x86 build tools" component. Without it, fall back to the
         host default (v145 on VS 2026). That works through the nvcc "allow-unsupported-compiler"
         option set below, which NVIDIA does not support. -->
    <!-- VS 2022 registers v143 under its own VCTargets; VS 2026 keeps it side by side in ..\v170\. -->
    <WarpV143Props>Platforms\x64\PlatformToolsets\v143\Toolset.props</WarpV143Props>
    <WarpPlatformToolset Condition="Exists('$(VCTargetsPath)$(WarpV143Props)') or Exists('$(VCTargetsPath)..\v170\$(WarpV143Props)')">v143</WarpPlatformToolset>
    <WarpPlatformToolset Condition="'$(WarpPlatformToolset)'==''">$(DefaultPlatformToolset)</WarpPlatformToolset>
  </PropertyGroup>
